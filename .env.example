# ─────────────────────────────────────────────────────────
# Clario — AI Finance Controller  |  Environment Variables
# ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env — it is git-ignored.

# ── Server ────────────────────────────────────────────────
# TCP port the Node server listens on (default: 3001)
PORT=3001

# ── MongoDB ───────────────────────────────────────────────
# Full connection string to your MongoDB Atlas cluster (or local instance).
# Leave blank to run in process-local demo mode (no persistence across restarts).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# MongoDB database name (default: ledgerpilot)
MONGODB_DB=ledgerpilot

# ── Mistral AI ────────────────────────────────────────────
# API key for Mistral AI (https://console.mistral.ai/).
# Leave blank to run in deterministic fallback mode — all risk scoring,
# evidence collection and policy evaluation still work without this key.
# Only LLM-generated narrative assessments are affected.
MISTRAL_API_KEY=

# Mistral model to use (default: mistral-small-latest)
MISTRAL_MODEL=mistral-small-latest

# ── Notes ─────────────────────────────────────────────────
# • The app runs fully without MONGODB_URI and MISTRAL_API_KEY.
#   All data is kept in memory for the process lifetime (demo mode).
# • With MONGODB_URI set, all reconciliation runs, audit events,
#   actions, investigations, and risk snapshots are persisted.
# • For Vercel deployment, add these as environment variables in the
#   Vercel project dashboard — do not upload .env files to Vercel.
